# ShopSphere Server Environment Variables
PORT=5000

# MongoDB Connection (MongoDB Atlas or local)
# Set MONGO_URI or MONGODB_URI (e.g. on Render):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shopsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend URL(s) for CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
