# ShopSphere Frontend Environment Configuration
# API Base Endpoint (e.g., http://localhost:5000 or http://localhost:5000/api in development, or https://your-backend.onrender.com in production)
# Note: The client automatically normalizes trailing slashes and ensures /api endpoints are routed correctly.
VITE_API_URL=http://localhost:5000

# Real-Time WebSocket Gateway (defaults to local Socket.io server, e.g., http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000
