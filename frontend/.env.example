# ShopSphere Frontend Environment Configuration
# API Base Endpoint (must include /api, e.g., http://localhost:5000/api or /api in production)
# Note: The client automatically normalizes trailing slashes and ensures the /api prefix is present
VITE_API_URL=http://localhost:5000/api

# Real-Time WebSocket Gateway (defaults to local Socket.io server, e.g., http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000
